  "spine": [
    {
      "act": "setup",
      "fromFrame": 5,
      "claim": "Every yes is a withdrawal from a finite account of time and energy, and most of us never agreed to those withdrawals."
    },
    {
      "act": "development",
      "fromFrame": 11681,
      "claim": "The reflex to say yes comes from guilt and the fear of disappointing people, and that reflex feels like kindness."
    },
    {
      "act": "turn",
      "fromFrame": 23042,
      "claim": "A short, clear no said early is more respectful than a vague maybe or a last-minute excuse."
    },
    {
      "act": "consequence",
      "fromFrame": 33715,
      "claim": "Holding a boundary costs some friction, but most relationships survive it and the friction fades."
    },
    {
      "act": "close",
      "fromFrame": 46438,
      "claim": "Protecting your time is what makes your real yeses valuable again."
    }
  ]
