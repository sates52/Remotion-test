      "act": "setup",
      "fromFrame": 2,
      "claim": "Creativity looks like a paradox: the most disciplined people are also the most playful."
    },
    {
      "act": "development",
      "fromFrame": 13805,
      "claim": "Creativity is a system of person, domain and field, not a gift."
    },
    {
      "act": "turn",
      "fromFrame": 27238,
      "claim": "The field decides what counts as new, so an idea is creative only once it is accepted."
    },
    {
      "act": "consequence",
      "fromFrame": 41882,
      "claim": "Discipline in a domain and openness in the person must work together."
    },
    {
