    "spine": [
      {
        "act": "setup",
        "fromFrame": 0,
        "claim": "A Red boy's life is sorted by color, and from inside the mines the Gold hierarchy looks like the natural order of things."
      },
      {
        "act": "promise",
        "fromFrame": 21482,
        "claim": "The pioneer myth of Mars is a promise to children, and it makes the cost of the mines bearable for Darrow and Eo."
      },
      {
        "act": "institute",
        "fromFrame": 42963,
        "claim": "The Institute and the arena show the system is designed to break the Reds, and Julian's kindness exposes the cruelty rather than softening it."
      },
      {
        "act": "refusal",
        "fromFrame": 64444,
        "claim": "Darrow sees that the gift he was taught to give his children was never his to give; the rebellion is a refusal to pass the chain on."
      }
    ]
